# Keep editor indentation aligned with the repository formatter.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = tab
tab_width = 2

# Markdown and YAML use spaces for structural indentation.
[*.{md,mdx,yml,yaml}]
indent_style = space
indent_size = 2

# Preserve intentional Markdown hard breaks while editing prose.
[*.{md,mdx}]
trim_trailing_whitespace = false
