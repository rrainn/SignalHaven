{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2020",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": ".",
		"outDir": "dist",
		"esModuleInterop": true,
		"types": ["node"],
		"composite": true,
		"tsBuildInfoFile": "../../node_modules/.cache/tsc/backend.tsbuildinfo"
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"],
	"references": [
		{
			"path": "../../packages/shared"
		}
	]
}
