{
	"name": "@signalhaven/backend",
	"version": "1.0.0",
	"private": true,
	"type": "commonjs",
	"main": "dist/src/index.js",
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsc --build",
		"lint": "eslint --cache --cache-location ../../node_modules/.cache/eslint/backend --ext .ts src tests",
		"test": "node --import tsx --test tests/*.test.ts",
		"test:coverage": "mkdir -p coverage && node --import tsx --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-exclude=src/**/*.d.ts --test-coverage-lines=${COVERAGE_LINES_THRESHOLD:-70} --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.ts",
		"db:migrate": "tsx src/db/scripts/migrate.ts",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.5.0",
		"@signalhaven/shared": "file:../../packages/shared",
		"archiver": "^7.0.1",
		"compression": "^1.8.1",
		"cors": "^2.8.6",
		"cron-parser": "^5.5.0",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"iconv-lite": "^0.7.2",
		"pg": "^8.20.0",
		"pg-copy-streams": "^7.0.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"pino-roll": "^4.0.0",
		"sax": "^1.6.0",
		"swagger-ui-express": "^5.0.1",
		"ws": "^8.21.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "^12.0.4",
		"@types/archiver": "^7.0.0",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"@types/pg-copy-streams": "^1.2.5",
		"@types/sax": "^1.2.7",
		"@types/supertest": "^7.2.1",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/ws": "^8.18.1",
		"drizzle-kit": "^0.31.10",
		"pino-pretty": "^13.1.3",
		"supertest": "^7.2.2",
		"tsx": "^4.23.1"
	}
}
